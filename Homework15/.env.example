# --- Настройки авторизации (JWT) ---
LOGIN=your_login_here
PASSWORD=your_password_here
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_TTL=1h

# --- Настройки PostgreSQL (ОСНОВНАЯ БД в HW15) ---
PG_DSN=postgres://chess:chess@localhost:5432/chess?sslmode=disable

# --- Настройки MongoDB (в HW15 не используется) ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB=chess

# --- Настройки Redis (в HW15 не используется) ---
REDIS_ADDR=localhost:6379
REDIS_TTL=24h